# Copy to .env and fill in. Never commit .env.

# PostgreSQL (Neon). Pooled URL for the app and collectors, direct URL for migrations.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/gimme?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/gimme?sslmode=require

# Optional API keys (phase 3+)
CFBD_API_KEY=
FOOTBALL_DATA_API_KEY=
ODDS_API_KEY=

# Collector settings
COLLECTOR_CACHE_DIR=./data/raw
MODEL_ARTIFACT_DIR=./data/models
COLLECTOR_USER_AGENT=gimme-a-W/0.1 (+https://github.com/bjhr730/gimme-a-W; contact: you@example.com)
